config I2C_GD32
	bool "GigaDevice GD32 I2C driver"
	default y
	depends on DT_HAS_GD_GD32_I2C_ENABLED
	select PINCTRL
	help
	  Enables GigaDevice GD32 I2C driver

config I2C_GD32_BUS_RECOVERY
	bool "GD32 I2C driver bus recovery support"
	default y if I2C_BUS_RECOVERY
	depends on I2C_GD32 && GPIO
	select I2C_BITBANG
	help
	  Enable GD32 I2C driver bus recovery support via GPIO bitbanging.
